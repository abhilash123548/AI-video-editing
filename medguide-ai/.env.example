# MedGuide AI — environment variables
# Copy to .env.local and fill in when connecting real backends.
# The public demo (/demo) works with ZERO environment variables configured.

# --- Supabase (real user mode; not required for demo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider (optional; falls back to deterministic demo AI when unset) ---
# When set, src/lib/ai/aiService.ts can be extended to route to a real provider
# instead of the built-in DemoAIProvider. Never expose this key to the client.
LLM_API_KEY=
LLM_PROVIDER=anthropic

# --- Future integrations (not wired up yet, interfaces only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
N8N_WEBHOOK_URL=
POSTHOG_KEY=
POSTHOG_HOST=
WHATSAPP_API_TOKEN=
