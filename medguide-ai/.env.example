# MedGuide AI — environment variables
# Copy to .env.local and fill in when connecting real backends.
# The public demo (/demo) works with ZERO environment variables configured.

# --- Supabase (real user mode; not required for demo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider (optional; falls back to deterministic demo AI when unset) ---
# Set LLM_API_KEY to a real Anthropic API key to turn on:
#   - real document analysis when a user uploads a record via
#     "+ Add Health Record" (src/lib/ai/documentAnalysis.ts, called from
#     POST /api/analyze-document) — the file is sent to Claude for a plain-
#     language summary, key values, explained terms, and discussion
#     questions, instead of asking the user to fill everything in by hand.
#   - grounded, real conversational answers from the AI Patient Advocate
#     chat for open-ended questions (src/lib/ai/aiService.ts RealAIProvider),
#     in addition to the deterministic explain/compare/prepare responses
#     that always work.
# Server-only — never exposed to the client. Leave unset to keep the whole
# app working exactly as it does in this build: honest manual entry on
# upload, and the deterministic demo AI for chat. No fake "AI read your
# file" behavior ever happens without this key actually being set.
LLM_API_KEY=
LLM_PROVIDER=anthropic
# Optional override; defaults to claude-sonnet-4-5 if unset.
LLM_MODEL=

# --- Future integrations (not wired up yet, interfaces only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
N8N_WEBHOOK_URL=
POSTHOG_KEY=
POSTHOG_HOST=
WHATSAPP_API_TOKEN=
